---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  showSimulation?: boolean;
}

const {
  title = "CMU CBUS",
  description = "A student-run organization advancing computational biology at Carnegie Mellon. We host academic and social events, connect students to opportunities, and advocate for them in the department.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-bg text-ink antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
  </head>

  <body class="min-h-screen flex flex-col selection:bg-accent-soft selection:text-accent relative">
    <div class="relative z-10 flex min-h-screen flex-col pointer-events-none [&_a]:pointer-events-auto [&_button]:pointer-events-auto [&_input]:pointer-events-auto [&_select]:pointer-events-auto [&_textarea]:pointer-events-auto">
      <Header />

      <main class="flex-1 w-full max-w-4xl mx-auto px-6 py-12">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
