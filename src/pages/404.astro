---
import Layout from "../layouts/Layout.astro";
import { IconHome, IconCalendarEvent } from "@tabler/icons-astro";
---
<Layout title="404: No Significant Hits | CMU CBUS">
  <section class="text-center space-y-4 max-w-xl mx-auto pt-2">
    <p class="font-mono text-xs text-accent tracking-wide">
      &gt; ATGC··NNNN··TAGC<span class="animate-blink inline-block text-accent font-bold">_</span>
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl text-ink font-semibold leading-tight tracking-tight">
      No significant hits
    </h1>
    <p class="text-muted text-sm sm:text-base leading-relaxed font-normal max-w-sm mx-auto">
      We ran a local alignment against every page on the site and came up empty.
      Either this URL never existed, or it's suffered a deletion mutation.
    </p>

    <div class="w-full max-w-xs mx-auto rounded-xl border border-ink/20 bg-surface/70 p-3.5 text-left font-mono text-[11px] leading-relaxed text-ink/80 shadow-2xs">
      <div class="mb-2 flex items-center justify-between border-b border-ink/10 pb-2 text-muted">
        <span>BLASTN 2.16.0+</span>
        <span>cbus_routes.fasta</span>
      </div>
      <dl class="space-y-0.5">
        <div class="flex gap-3">
          <dt class="w-14 shrink-0 text-accent">Query=</dt>
          <dd class="truncate" data-path>/resources</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-14 shrink-0 text-accent">Length=</dt>
          <dd><span data-length>10</span></dd>
        </div>
      </dl>
      <p class="mt-2 text-accent">***** No hits found *****</p>
    </div>

    <div class="pt-1 flex items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-xl border border-accent bg-bg px-5 py-2 font-sans text-sm font-medium text-accent transition-colors hover:bg-accent-soft"
      >
        <IconHome size={16} aria-hidden="true" />
        <span>Back home</span>
      </a>
      <a
        href="/events"
        class="inline-flex items-center gap-1.5 rounded-xl border border-ink/20 bg-surface/30 px-5 py-2 font-sans text-sm font-medium text-ink/90 shadow-2xs transition-all hover:border-accent hover:text-accent"
      >
        <IconCalendarEvent size={16} aria-hidden="true" />
        <span>See events</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .animate-blink {
    animation: blink 1s step-start infinite;
  }
</style>

<script>
  const pathEl = document.querySelector('[data-path]');
  const lengthEl = document.querySelector('[data-length]');
  const path = window.location.pathname || '/';
  if (pathEl) pathEl.textContent = path;
  if (lengthEl) lengthEl.textContent = String(path.length);
</script>
