---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import EventCard from '../components/EventCard.astro';
import { IconCalendar } from '@tabler/icons-astro';

const [month, day, year] = new Date()
  .toLocaleDateString('en-US', { timeZone: 'America/New_York' }).split('/').map(Number);
const today = Date.UTC(year, month - 1, day);

const events = (await getCollection('events'))
  .filter(({ data }) => data.date.getTime() >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Layout
  title="Events | CMU CBUS"
  description="Upcoming events, workshops, and socials hosted by the CMU Computational Biology Undergraduate Society."
>
  <header class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-serif text-5xl font-medium text-ink sm:text-6xl">
        Events
      </h1>
      <p class="mt-2 text-lg text-muted">
        Upcoming socials, workshops, and academic events.
      </p>
    </div>

    <a
      href="https://calendar.google.com/calendar/render?cid=c_42e7212d78d228c2cd2bb62fc7cd9f709a982e3ed09ea96cec26d32d72c3f19f%40group.calendar.google.com"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-fit items-center gap-2 rounded-lg border border-ink/10 bg-surface/40 px-3 py-1.5 text-base font-medium text-ink transition-all hover:border-accent/40 hover:bg-surface hover:text-accent"
    >
      <IconCalendar size={18} />
      <span>Subscribe to Calendar</span>
    </a>
  </header>

  <div class="grid gap-6">
    {events.map(({ data }) => (
      <div data-event-date={data.date.getTime()}>
        <EventCard {...data} />
      </div>
    ))}
  </div>
  <p data-events-empty hidden={events.length > 0} class="text-lg text-muted">No upcoming events right now. Check back soon!</p>
</Layout>

<script>
  const [month, day, year] = new Date()
    .toLocaleDateString('en-US', { timeZone: 'America/New_York' }).split('/').map(Number);
  const today = Date.UTC(year, month - 1, day);
  let hasUpcomingEvents = false;

  for (const event of document.querySelectorAll<HTMLElement>('[data-event-date]')) {
    event.hidden = Number(event.dataset.eventDate) < today;
    hasUpcomingEvents ||= !event.hidden;
  }

  const emptyState = document.querySelector<HTMLElement>('[data-events-empty]');
  if (emptyState) emptyState.hidden = hasUpcomingEvents;
</script>
