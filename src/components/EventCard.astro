---
interface Props {
  title: string;
  date: Date;
  time: string;
  location: string;
  locationDetails?: string;
  description: string;
  highlights?: { title: string; description: string }[];
  rsvpNote?: string;
  links?: { text: string; url: string }[];
}

const { title, date, time, location, locationDetails, description, highlights = [], rsvpNote, links = [] } = Astro.props;
const formatDate = (options: Intl.DateTimeFormatOptions) =>
  date.toLocaleDateString('en-US', { ...options, timeZone: 'UTC' });
---

<article class="pointer-events-auto overflow-hidden rounded-xl border border-border bg-surface/40 sm:grid sm:grid-cols-[6.5rem_minmax(0,1fr)]">
  <div class="border-b border-border bg-accent/[0.035] px-6 py-4 sm:border-r sm:border-b-0 sm:px-3 sm:py-6">
    <time
      datetime={date.toISOString().slice(0, 10)}
      aria-label={formatDate({ weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
      class="flex items-center gap-3 sm:flex-col sm:gap-0 sm:text-center"
    >
      <span class="font-mono text-xs uppercase tracking-widest text-accent">{formatDate({ month: 'short' })}</span>
      <span class="font-serif text-4xl leading-none text-accent sm:mt-2 sm:block sm:text-5xl">{formatDate({ day: 'numeric' })}</span>
      <span class="text-sm text-muted sm:mt-2 sm:block">{formatDate({ year: 'numeric' })}</span>
    </time>
  </div>

  <div class="p-6 sm:px-7">
    <header>
      <h2 class="font-serif text-3xl font-medium leading-tight text-ink">{title}</h2>
      <p class="mt-2 flex flex-wrap items-baseline gap-x-2 text-base leading-relaxed text-ink/80">
        <span>{location}</span>
        <span class="whitespace-nowrap"><span aria-hidden="true">· </span>{time}</span>
      </p>
      {locationDetails && <p class="mt-0.5 text-sm leading-relaxed text-muted">{locationDetails}</p>}
    </header>

    <div class="mt-4 space-y-3 text-base leading-relaxed text-ink/80">
      {description.trim().split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {highlights.length > 0 && (
      <dl class="mt-4 grid gap-4 text-sm leading-relaxed md:grid-cols-2 md:gap-6">
        {highlights.map((highlight) => (
          <div>
            <dt class="font-medium text-ink">{highlight.title}</dt>
            <dd class="mt-1 text-muted">{highlight.description}</dd>
          </div>
        ))}
      </dl>
    )}

    {(rsvpNote || links.length > 0) && (
      <footer class="mt-4 border-t border-border pt-4">
        {links.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-accent/30 bg-accent-soft px-4 py-2 text-base font-medium text-accent transition-colors hover:border-accent hover:bg-accent/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              >
                {link.text}<span aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        )}
        {rsvpNote && <p class:list={['text-sm leading-relaxed text-muted', { 'mt-3': links.length > 0 }]}>{rsvpNote}</p>}
      </footer>
    )}
  </div>
</article>
