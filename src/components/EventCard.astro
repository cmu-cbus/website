---
interface EventLink {
  text: string;
  url: string;
}

interface Props {
  title: string;
  date: Date;
  time: string;
  location: string;
  description: string;
  tags?: string[];
  links?: EventLink[];
}

const { title, date, time, location, description, tags, links } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<div class="group relative pointer-events-auto flex flex-col justify-between rounded-xl border border-border bg-surface/40 p-6 transition-all hover:border-accent/40 hover:bg-surface">
  <div>
    <div class="flex items-center justify-between text-xs text-muted mb-3">
      <time datetime={date.toISOString()}>{formattedDate} • {time}</time>
      {tags && tags.length > 0 && (
        <div class="flex gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-medium text-accent">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <h3 class="font-serif text-xl font-medium text-ink">
      {title}
    </h3>
    <p class="mt-1 text-xs text-muted">📍 {location}</p>

    <p class="mt-3 text-sm leading-relaxed text-ink/80">
      {description}
    </p>
  </div>

  {links && links.length > 0 && (
    <div class="mt-4 flex flex-col gap-1.5">
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-1 text-xs font-medium text-accent hover:underline"
        >
          {link.text} &rarr;
        </a>
      ))}
    </div>
  )}
</div>
