---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
const base = import.meta.env.BASE_URL;

const navItems = [
  { label: "Home", href: base },
  { label: "Events", href: `${base}events` },
  { label: "Board", href: `${base}board` },
  { label: "Resources", href: `${base}resources` },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === base ? currentPath === base : currentPath.startsWith(href);
---

<header class="top-0 z-50 w-full border-b border-border/40">
  <div class="mx-auto flex flex-col items-center gap-4 pt-6 pb-4">
    <a href={base} class="transition-opacity hover:opacity-85">
      <Image
        src={logo}
        alt="CBUS Logo"
        class="h-20 w-auto object-contain"
      />
    </a>

    <nav aria-label="Primary" class="flex items-center gap-6 font-sans text-lg mt-1">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "transition-colors focus-visible:outline-2 focus-visible:outline-accent",
              active
                ? "font-semibold text-ink"
                : "text-muted hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
