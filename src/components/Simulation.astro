---
interface Props {
  feed?: number;
  kill?: number;
  opacity?: number;
  substeps?: number;
  blobs?: number;
}

const {
  feed = 0.0260,
  kill = 0.0550,
  opacity = 0.3,
  substeps = 4,
  blobs = 1,
} = Astro.props;
---

<div class="rd-wrapper">
  <canvas class="rd-canvas" aria-hidden="true"></canvas>
</div>

<script data-feed={feed} data-kill={kill} data-opacity={opacity} data-substeps={substeps} data-blobs={blobs}>
(function () {
  const scriptTag = document.currentScript;

  function hexToRgb(hex) {
    let clean = hex.replace('#', '').trim();
    if (clean.length === 3) clean = clean.split('').map((c) => c + c).join('');
    const n = parseInt(clean, 16);
    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  }

  function getCSSColor(varName, fallbackHex) {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
    return hexToRgb(raw || fallbackHex);
  }

  function initSim(scriptTag) {
    const wrapper = scriptTag && scriptTag.previousElementSibling;
    const canvas = wrapper && wrapper.querySelector('.rd-canvas');
    if (!canvas) return;

    if (localStorage.getItem('cbus:simulation-enabled') === 'false') {
      if (wrapper) wrapper.style.display = 'none';
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const gl = canvas.getContext('webgl2', { alpha: true, premultipliedAlpha: false });
    if (!gl) {
      console.warn('reaction-diffusion background: WebGL2 is not available in this browser, skipping.');
      return;
    }

    const floatExt = gl.getExtension('EXT_color_buffer_float');
    if (!floatExt) {
      console.warn('reaction-diffusion background: EXT_color_buffer_float is not supported, skipping.');
      return;
    }

    const feed = Number(scriptTag?.dataset.feed);
    const kill = Number(scriptTag?.dataset.kill );
    const opacity = Number(scriptTag?.dataset.opacity);
    const substeps = Math.max(1, Number(scriptTag?.dataset.substeps));
    const blobCount = Math.min(16, Math.max(0, Math.round(Number(scriptTag?.dataset.blobs ?? 0))));
    const seed = Math.random() * 1000.0;

    const SIM_HEIGHT = 768;
    const INJECT_HOLD_FRAMES = 12;

    let colorBg = getCSSColor('--color-bg', '#faf8f6');
    let colorAccent = getCSSColor('--color-accent', '#a94545');

    let simW = 0;
    let simH = 0;
    let canvasW = 0;
    let canvasH = 0;
    let rafId = null;
    let resizeTimeout = null;
    let current = 0;
    const inject = { x: 0, y: 0, active: false, framesLeft: 0 };
    let paintDown = false;

    function compile(type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
        console.error('reaction-diffusion shader compile error:', gl.getShaderInfoLog(s));
      }
      return s;
    }

    function createProg(vsSrc, fsSrc) {
      const vs = compile(gl.VERTEX_SHADER, vsSrc);
      const fs = compile(gl.FRAGMENT_SHADER, fsSrc);
      const p = gl.createProgram();
      gl.attachShader(p, vs);
      gl.attachShader(p, fs);
      gl.bindAttribLocation(p, 0, 'a_pos');
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
        console.error('reaction-diffusion program link error:', gl.getProgramInfoLog(p));
      }
      gl.deleteShader(vs);
      gl.deleteShader(fs);
      return p;
    }

    function getUniforms(program, names) {
      const locs = {};
      for (const n of names) locs[n] = gl.getUniformLocation(program, n);
      return locs;
    }

    const QUAD_VS = `#version 300 es
    in vec2 a_pos;
    out vec2 v_uv;
    void main() {
      v_uv = a_pos * 0.5 + 0.5;
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }`;

    const INIT_FS = `#version 300 es
    precision highp float;
    in vec2 v_uv;
    out vec4 outColor;
    uniform vec2 u_screen;
    uniform float u_seed;
    uniform int u_blobCount;

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    void main() {
      vec2 extent = u_screen / min(u_screen.x, u_screen.y);
      vec2 st = (v_uv - 0.5) * extent;

      float u = 1.0;
      float v = 0.0;

      for (int i = 0; i < 16; i++) {
        if (i >= u_blobCount) break;
        float fi = float(i);
        float rx = hash(vec2(fi, u_seed)) - 0.5;
        float ry = hash(vec2(fi + 31.7, u_seed * 1.37)) - 0.5;
        vec2 center = vec2(rx, ry) * extent * 0.75;
        float rr = 0.028 + hash(vec2(fi + 71.3, u_seed * 2.11)) * 0.02;
        if (length(st - center) < rr) {
          u = 0.5;
          v = 0.25;
        }
      }

      outColor = vec4(u, v, 0.0, 1.0);
    }`;

    const REACT_FS = `#version 300 es
    precision highp float;
    in vec2 v_uv;
    out vec4 outColor;
    uniform sampler2D u_state;
    uniform vec2 u_texel;
    uniform float u_feed;
    uniform float u_kill;
    uniform float u_du;
    uniform float u_dv;
    uniform float u_dt;
    uniform vec2 u_inject;
    uniform float u_injectActive;

    vec2 laplacian(vec2 uv) {
      vec2 sum = vec2(0.0);
      sum += texture(u_state, uv + vec2(-u_texel.x, 0.0)).rg * 0.2;
      sum += texture(u_state, uv + vec2(u_texel.x, 0.0)).rg * 0.2;
      sum += texture(u_state, uv + vec2(0.0, -u_texel.y)).rg * 0.2;
      sum += texture(u_state, uv + vec2(0.0, u_texel.y)).rg * 0.2;
      sum += texture(u_state, uv + vec2(-u_texel.x, -u_texel.y)).rg * 0.05;
      sum += texture(u_state, uv + vec2(u_texel.x, -u_texel.y)).rg * 0.05;
      sum += texture(u_state, uv + vec2(-u_texel.x, u_texel.y)).rg * 0.05;
      sum += texture(u_state, uv + vec2(u_texel.x, u_texel.y)).rg * 0.05;
      sum -= texture(u_state, uv).rg;
      return sum;
    }

    void main() {
      vec2 state = texture(u_state, v_uv).rg;
      float u = state.r;
      float v = state.g;
      vec2 lap = laplacian(v_uv);
      float uvv = u * v * v;

      float du = u_du * lap.r - uvv + u_feed * (1.0 - u);
      float dv = u_dv * lap.g + uvv - (u_feed + u_kill) * v;

      u += du * u_dt;
      v += dv * u_dt;

      if (u_injectActive > 0.5) {
        float d = distance(gl_FragCoord.xy, u_inject);
        if (d < 7.0) {
          u = 0.5;
          v = 0.25;
        }
      }

      outColor = vec4(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0), 0.0, 1.0);
    }`;

    const DISPLAY_FS = `#version 300 es
    precision highp float;
    in vec2 v_uv;
    out vec4 outColor;
    uniform sampler2D u_state;
    uniform vec3 u_bg;
    uniform vec3 u_accent;
    uniform float u_op;

    void main() {
      vec2 state = texture(u_state, v_uv).rg;
      float intensity = smoothstep(0.05, 0.35, state.g);
      outColor = vec4(mix(u_bg, u_accent, intensity), intensity * u_op);
    }`;

    const initProg = createProg(QUAD_VS, INIT_FS);
    const reactProg = createProg(QUAD_VS, REACT_FS);
    const displayProg = createProg(QUAD_VS, DISPLAY_FS);

    const initU = getUniforms(initProg, ['u_screen', 'u_seed', 'u_blobCount']);
    const reactU = getUniforms(reactProg, ['u_state', 'u_texel', 'u_feed', 'u_kill', 'u_du', 'u_dv', 'u_dt', 'u_inject', 'u_injectActive']);
    const displayU = getUniforms(displayProg, ['u_state', 'u_bg', 'u_accent', 'u_op']);

    const quadVAO = gl.createVertexArray();
    gl.bindVertexArray(quadVAO);
    const quadBuf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quadBuf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    let textures = [];
    let fbos = [];

    function createTarget(width, height) {
      const tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RG16F, width, height, 0, gl.RG, gl.FLOAT, null);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

      const fbo = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
      return { tex, fbo };
    }

    function seedInitialState(overrideBlobCount) {
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbos[0]);
      gl.viewport(0, 0, simW, simH);
      gl.useProgram(initProg);
      gl.bindVertexArray(quadVAO);
      gl.uniform2f(initU.u_screen, simW, simH);
      gl.uniform1f(initU.u_seed, seed);
      gl.uniform1i(initU.u_blobCount, overrideBlobCount ?? blobCount);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      current = 0;
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvasW = Math.max(1, Math.round(rect.width * dpr));
      canvasH = Math.max(1, Math.round(rect.height * dpr));

      canvas.width = canvasW;
      canvas.height = canvasH;

      const aspect = rect.width / rect.height;
      const newSimH = SIM_HEIGHT;
      const newSimW = Math.round(SIM_HEIGHT * aspect);

      if (newSimW === simW && newSimH === simH) return;
      simW = newSimW;
      simH = newSimH;

      if (textures.length > 0) {
        gl.deleteTexture(textures[0]);
        gl.deleteTexture(textures[1]);
        gl.deleteFramebuffer(fbos[0]);
        gl.deleteFramebuffer(fbos[1]);
      }

      const a = createTarget(simW, simH);
      const b = createTarget(simW, simH);
      textures = [a.tex, b.tex];
      fbos = [a.fbo, b.fbo];

      seedInitialState();
    }

    function onResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(resize, 150);
    }

    function seedFromEvent(e) {
      const target = e.target;
      if (target && target.closest('header, nav, a, button')) {
        return;
      }

      const rect = canvas.getBoundingClientRect();
      const relX = (e.clientX - rect.left) / rect.width;
      const relY = 1.0 - (e.clientY - rect.top) / rect.height;
      inject.x = relX * simW;
      inject.y = relY * simH;
      inject.active = true;
      inject.framesLeft = INJECT_HOLD_FRAMES;
    }
    function onPointerDown(e) {
      paintDown = true;
      seedFromEvent(e);
    }

    function onPointerMove(e) {
      if (paintDown) seedFromEvent(e);
    }

    function onPointerUp() {
      paintDown = false;
    }

    function onVisibilityChange() {
      if (document.hidden) {
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = null;
      } else if (rafId === null && !reducedMotion) {
        rafId = requestAnimationFrame(loop);
      }
    }

    const themeObserver = new MutationObserver(() => {
      colorBg = getCSSColor('--color-bg', '#faf8f6');
      colorAccent = getCSSColor('--color-accent', '#a94545');
    });
    themeObserver.observe(document.documentElement, { attributes: true });

    resize();

    function stepOnce(srcIdx, allowInject) {
      const dstIdx = 1 - srcIdx;
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbos[dstIdx]);
      gl.viewport(0, 0, simW, simH);
      gl.useProgram(reactProg);
      gl.bindVertexArray(quadVAO);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, textures[srcIdx]);
      gl.uniform1i(reactU.u_state, 0);
      gl.uniform2f(reactU.u_texel, 1 / simW, 1 / simH);
      gl.uniform1f(reactU.u_feed, feed);
      gl.uniform1f(reactU.u_kill, kill);
      gl.uniform1f(reactU.u_du, 1.0);
      gl.uniform1f(reactU.u_dv, 0.5);
      gl.uniform1f(reactU.u_dt, 1.0);
      gl.uniform1f(reactU.u_injectActive, allowInject && inject.active ? 1 : 0);
      gl.uniform2f(reactU.u_inject, inject.x, inject.y);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      return dstIdx;
    }

    function display() {
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, canvasW, canvasH);
      gl.useProgram(displayProg);
      gl.bindVertexArray(quadVAO);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, textures[current]);
      gl.uniform1i(displayU.u_state, 0);
      gl.uniform3f(displayU.u_bg, ...colorBg);
      gl.uniform3f(displayU.u_accent, ...colorAccent);
      gl.uniform1f(displayU.u_op, opacity);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    function loop() {
      if (simW === 0 || simH === 0) {
        rafId = requestAnimationFrame(loop);
        return;
      }

      for (let s = 0; s < substeps; s++) {
        current = stepOnce(current, s === 0);
      }

      if (inject.active) {
        inject.framesLeft -= 1;
        if (inject.framesLeft <= 0) inject.active = false;
      }

      display();
      rafId = requestAnimationFrame(loop);
    }

    window.addEventListener('resize', onResize);
    window.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    document.addEventListener('visibilitychange', onVisibilityChange);

    function teardown() {
      if (rafId !== null) cancelAnimationFrame(rafId);
      clearTimeout(resizeTimeout);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('pointerdown', onPointerDown);
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      themeObserver.disconnect();
    }

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = null;
    });

    canvas.addEventListener('webglcontextrestored', () => {
      teardown();
      initSim(scriptTag);
    });

    document.addEventListener('astro:before-swap', teardown, { once: true });

    if (reducedMotion) {
      if (blobCount === 0) seedInitialState(7);
      for (let i = 0; i < 10000; i++) {
        current = stepOnce(current, false);
      }
      display();
    } else {
      rafId = requestAnimationFrame(loop);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initSim(scriptTag));
  } else {
    initSim(scriptTag);
  }
})();
</script>

<style>
  .rd-wrapper {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: transparent;
  }

  .rd-canvas {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>
