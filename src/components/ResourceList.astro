---
import { IconExternalLink, IconChevronRight, IconSearch } from '@tabler/icons-astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'resources'>[];
}

const { entries } = Astro.props;

const sections = new Map<string, CollectionEntry<'resources'>[]>();
for (const entry of entries) {
  const key = entry.data.section;
  if (!sections.has(key)) sections.set(key, []);
  sections.get(key)!.push(entry);
}
for (const list of sections.values()) {
  list.sort((a, b) => b.data.priority - a.data.priority);
}
---

<div class="mb-8 relative">
  <IconSearch size={15} class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" aria-hidden="true" />
  <input
    type="text"
    id="resource-search"
    placeholder="Search resources…"
    aria-label="Search resources"
    class="w-full rounded-xl border border-ink/20 bg-surface/30 py-2 pl-9 pr-4 font-sans text-lg text-ink placeholder:text-muted focus:outline-none focus:border-accent transition-colors"
  />
</div>

<div class="space-y-6" id="resource-groups">
  {Array.from(sections.entries()).map(([section, items]) => (
    <div class="resource-group">
      <h2 class="font-mono text-base uppercase tracking-wide text-muted mb-1">{section}</h2>
      <ul class="divide-y divide-ink/10">
        {items.map((item) => {
          const isExternal = Boolean(item.data.url);
          const href = isExternal ? item.data.url : `/resources/${item.id}`;
          return (
            <li class="resource-row">
              <a
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="group flex items-center justify-between gap-4 py-3"
              >
                <span>
                  <span class="block text-lg font-medium text-ink group-hover:text-accent transition-colors">
                    {item.data.title}
                  </span>
                  {item.data.description && (
                    <span class="block text-base text-muted mt-0.5">{item.data.description}</span>
                  )}
                </span>
                {isExternal ? (
                  <IconExternalLink size={20} class="shrink-0 text-muted group-hover:text-accent transition-colors" aria-hidden="true" />
                ) : (
                  <IconChevronRight size={20} class="shrink-0 text-muted group-hover:text-accent transition-colors" aria-hidden="true" />
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>

<p id="resource-empty" class="hidden text-lg text-muted">No matching resources.</p>

<script>
  const input = document.getElementById('resource-search') as HTMLInputElement | null;
  const groups = document.querySelectorAll<HTMLElement>('.resource-group');
  const emptyState = document.getElementById('resource-empty');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let anyVisible = false;

    groups.forEach((group) => {
      const rows = group.querySelectorAll<HTMLElement>('.resource-row');
      let groupHasMatch = false;

      rows.forEach((row) => {
        const text = row.textContent?.toLowerCase() ?? '';
        const matches = query === '' || text.includes(query);
        row.classList.toggle('hidden', !matches);
        if (matches) groupHasMatch = true;
      });

      group.classList.toggle('hidden', !groupHasMatch);
      if (groupHasMatch) anyVisible = true;
    });

    emptyState?.classList.toggle('hidden', anyVisible || query === '');
  });
</script>
