---
import {
  IconCoffee,
  IconMail,
  IconWorld,
  IconBrandLinkedin,
  IconBrandGithub
} from '@tabler/icons-astro';

const base = import.meta.env.BASE_URL;

interface Props {
  name: string;
  role: string;
  image: string;
  bio: string;
  coffeeChat: string;
  email?: string;
  linkedin?: string;
  github?: string;
  website?: string;
}

const { name, role, image, bio, coffeeChat, email, linkedin, github, website } = Astro.props;

const emailHref = email ? (email.startsWith('mailto:') ? email : `mailto:${email}`) : null;
---

<div class="pointer-events-auto flex flex-col gap-5 rounded-xl border border-ink/10 bg-surface/40 p-5 transition-all hover:border-accent/40 hover:bg-surface sm:flex-row sm:items-start sm:p-6">
  <img
    src={`${base}${image}`}
    alt={name}
    class="h-40 w-40 shrink-0 rounded-lg border border-ink/10 object-cover sm:h-45 sm:w-45"
    loading="lazy"
  />

  <div class="flex flex-1 flex-col justify-between">
    <div>
      <span class="text-base font-semibold uppercase tracking-wider text-accent">
        {role}
      </span>
      <h3 class="font-serif text-3xl font-medium text-ink">
        {name}
      </h3>
      <p class="mt-2 text-lg leading-relaxed text-ink/80">
        {bio}
      </p>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <a
        href={coffeeChat}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-surface/60 px-3 py-1 text-base font-medium text-ink transition-all hover:border-accent/40 hover:bg-surface hover:text-accent"
      >
        <IconCoffee size={18} />
        <span>Coffee Chat</span>
      </a>

      {emailHref && (
        <a
          href={emailHref}
          class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-surface/60 px-3 py-1 text-base font-medium text-ink transition-all hover:border-accent/40 hover:bg-surface hover:text-accent"
        >
          <IconMail size={18} />
          <span>Email</span>
        </a>
      )}

      {linkedin && (
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-surface/60 px-3 py-1 text-base font-medium text-ink transition-all hover:border-accent/40 hover:bg-surface hover:text-accent"
        >
          <IconBrandLinkedin size={18} />
          <span>LinkedIn</span>
        </a>
      )}

      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-surface/60 px-3 py-1 text-base font-medium text-ink transition-all hover:border-accent/40 hover:bg-surface hover:text-accent"
        >
          <IconBrandGithub size={18} />
          <span>GitHub</span>
        </a>
      )}

      {website && (
        <a
          href={website}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-surface/60 px-3 py-1 text-base font-medium text-ink transition-all hover:border-accent/40 hover:bg-surface hover:text-accent"
        >
          <IconWorld size={18} />
          <span>Website</span>
        </a>
      )}
    </div>
  </div>
</div>
