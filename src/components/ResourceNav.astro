---
import { IconExternalLink } from '@tabler/icons-astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'resources'>[];
  activeId?: string;
}

const { entries, activeId } = Astro.props;

const sections = new Map<string, CollectionEntry<'resources'>[]>();
for (const entry of entries) {
  const key = entry.data.section;
  if (!sections.has(key)) sections.set(key, []);
  sections.get(key)!.push(entry);
}
for (const list of sections.values()) {
  list.sort((a, b) => b.data.priority - a.data.priority);
}
---
<nav class="font-sans text-sm space-y-6" aria-label="Resource sections">
  {Array.from(sections.entries()).map(([section, items]) => (
    <div>
      <p class="font-mono text-[11px] uppercase tracking-wide text-muted mb-2">{section}</p>
      <ul class="space-y-0.5">
        {items.map((item) => {
          const isExternal = Boolean(item.data.url);
          const isActive = item.id === activeId;
          const href = isExternal ? item.data.url : `/resources/${item.id}`;
          return (
            <li>
              <a
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class:list={[
                  'flex items-center justify-between gap-2 border-l pl-3 pr-2 py-1.5 -ml-px transition-colors',
                  isActive
                    ? 'border-accent text-accent font-medium'
                    : 'border-ink/10 text-ink/80 hover:border-accent/50 hover:text-accent',
                ]}
              >
                <span class="truncate">{item.data.title}</span>
                {isExternal && (
                  <IconExternalLink size={13} class="shrink-0 text-muted" aria-hidden="true" />
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
